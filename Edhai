-- Guardar todos los puntos
local function saveAllPoints()
    for name, data in pairs(points) do
        local saveData = {
            x = data.cframe.X,
            y = data.cframe.Y,
            z = data.cframe.Z,
            rx = data.cframe:ToEulerAnglesXYZ(),
            r = data.color.r,
            g = data.color.g,
            b = data.color.b
        }
        pcall(function()
            writefile(pointsFolder .. "/" .. name .. ".json", game:GetService("HttpService"):JSONEncode(saveData))
        end)
    end
    DiscordLib:Notification("Puntos", "Puntos guardados", "OK")
end

-- Cargar todos los puntos
local function loadAllPoints()
    points = {}
    local files = listfiles(pointsFolder)
    for _, file in ipairs(files) do
        if file:match("%.json$") then
            local success, content = pcall(readfile, file)
            if success and content then
                local data = game:GetService("HttpService"):JSONDecode(content)
                local pointName = file:match("([^/]+)%.json$")
                local cframe = CFrame.new(data.x, data.y, data.z) * CFrame.fromEulerAnglesXYZ(data.rx[1] or 0, data.rx[2] or 0, data.rx[3] or 0)
                points[pointName] = {
                    cframe = cframe,
                    color = Color3.new(data.r or 1, data.g or 0, data.b or 0)
                }
            end
        end
    end
    refreshPointsDropdown()  -- Actualizar dropdown
    if espEnabled then updateESP() end
    return #files
end

-- Guardar punto actual
local function saveCurrentPoint()
    if pendingPointName == "" then
        DiscordLib:Notification("Error", "Escribe un nombre primero", "OK")
        return
    end
    local char = game.Players.LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        DiscordLib:Notification("Error", "Personaje no disponible", "OK")
        return
    end
    points[pendingPointName] = {
        cframe = char.HumanoidRootPart.CFrame,
        color = pendingPointColor
    }
    saveAllPoints()
    refreshPointsDropdown()
    if espEnabled then updateESP() end
    DiscordLib:Notification("Punto guardado", pendingPointName, "OK")
end

-- Cargar punto
local function loadPoint(name)
    local point = points[name]
    if not point then
        DiscordLib:Notification("Error", "Punto no encontrado", "OK")
        return
    end
    local char = game.Players.LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = point.cframe
        DiscordLib:Notification("Teletransporte", "Cargando: " .. name, "OK")
    end
end

-- Eliminar punto
local function deletePoint(name)
    if points[name] then
        points[name] = nil
        local filePath = pointsFolder .. "/" .. name .. ".json"
        pcall(function() delfile(filePath) end)
        refreshPointsDropdown()
        if espEnabled then updateESP() end
        DiscordLib:Notification("Punto eliminado", name, "OK")
        if currentSelectedPoint == name then currentSelectedPoint = nil end
    end
end

-- Editar nombre
local function editPointName(oldName, newName)
    if not points[oldName] then
        DiscordLib:Notification("Error", "Punto no encontrado", "OK")
        return
    end
    if newName == "" or points[newName] then
        DiscordLib:Notification("Error", "Nombre inválido o ya existe", "OK")
        return
    end
    points[newName] = points[oldName]
    points[oldName] = nil
    local oldPath = pointsFolder .. "/" .. oldName .. ".json"
    pcall(function() delfile(oldPath) end)
    saveAllPoints()
    refreshPointsDropdown()
    if espEnabled then updateESP() end
    DiscordLib:Notification("Punto renombrado", oldName .. " → " .. newName, "OK")
    if currentSelectedPoint == oldName then currentSelectedPoint = newName end
end

-- ============================================
-- DROPDOWN DINÁMICO (RECREAR CADA VEZ)
-- ============================================
local pointsDropdown = nil
local dropdownContainer = nil

local function refreshPointsDropdown()
    -- Si ya existe el dropdown, destruirlo y recrearlo
    if pointsDropdown then
        -- Buscar el contenedor padre y eliminar el dropdown viejo
        -- La librería no tiene método remove, así que recreamos desde el elemento padre
        local success = pcall(function()
            -- Intentamos acceder al elemento de la interfaz
            if pointsDropdown and pointsDropdown.Remove then
                pointsDropdown:Remove()
            end
        end)
    end
    
    -- Crear nueva lista de opciones
    local options = {}
    for name, _ in pairs(points) do
        table.insert(options, name)
    end
    table.sort(options)
    if #options == 0 then
        table.insert(options, "(No hay puntos)")
    end
    
    -- Crear nuevo dropdown
    pointsDropdown = TabGuiV1:Dropdown("Puntos guardados", options, function(value)
        if value ~= "(No hay puntos)" then
            currentSelectedPoint = value
        end
    end)
end

-- ============================================
-- ESP VISUAL
-- ============================================
local function createESPForPoint(name, point)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "PointESP_" .. name
    billboard.Size = UDim2.new(0, 200, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = point.color
    frame.BackgroundTransparency = 0.5
    frame.BorderSizePixel = 1
    frame.BorderColor3 = Color3.new(1, 1, 1)
    frame.Parent = billboard
    
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = name .. "\n" .. string.format("X: %.0f Y: %.0f Z: %.0f", point.cframe.X, point.cframe.Y, point.cframe.Z)
    text.TextColor3 = Color3.new(1, 1, 1)
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    text.Parent = frame
    
    local part = Instance.new("Part")
    part.Name = "ESP_Part_" .. name
    part.Size = Vector3.new(0.5, 0.5, 0.5)
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 1
    part.Position = point.cframe.Position
    part.Parent = workspace
    billboard.Adornee = part
    
    espObjects[name] = {billboard = billboard, part = part}
end

local function clearESP()
    for name, objs in pairs(espObjects) do
        pcall(function()
            if objs.billboard then objs.billboard:Destroy() end
            if objs.part then objs.part:Destroy() end
        end)
    end
    espObjects = {}
end

local function updateESP()
    clearESP()
    if not espEnabled then return end
    for name, point in pairs(points) do
        pcall(function() createESPForPoint(name, point) end)
    end
end

local function toggleESP(state)
    espEnabled = state
    if state then
        updateESP()
    else
        clearESP()
    end
end

