    label.Text = playerName .. " [" .. (playerTeam and playerTeam.Name or "Sin equipo") .. "]"
    label.Font = Enum.Font.Arcade
    label.TextSize = 10
    label.TextColor3 = teamColor
    label.Parent = billboard
    
    table.insert(playerEspObjects, {box = box, billboard = billboard, hrp = hrp})
end

local function clearPlayerESP()
    for _, obj in ipairs(playerEspObjects) do
        pcall(function()
            if obj.box then obj.box:Destroy() end
            if obj.billboard then obj.billboard:Destroy() end
        end)
    end
    playerEspObjects = {}
end

local function setupPlayerESP(player)
    if player == LocalPlayer then return end
    
    local function onChar(char)
        task.wait(1)
        if char and playerEspEnabled then
            createPlayerESP(char, player.Name, player.Team)
        end
    end
    
    if player.Character then onChar(player.Character) end
    player.CharacterAdded:Connect(onChar)
    
    -- Actualizar si cambia de equipo
    player:GetPropertyChangedSignal("Team"):Connect(function()
        if player.Character and playerEspEnabled then
            clearPlayerESP()
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    createPlayerESP(p.Character, p.Name, p.Team)
                end
            end
        end
    end)
end

local function togglePlayerESP()
    playerEspEnabled = not playerEspEnabled
    if playerEspEnabled then
        clearPlayerESP()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                createPlayerESP(p.Character, p.Name, p.Team)
            end
        end
        Print("👁️ ESP de jugadores ACTIVADO")
    else
        clearPlayerESP()
        Print("👁️ ESP de jugadores DESACTIVADO")
    end
end

