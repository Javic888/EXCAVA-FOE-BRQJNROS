tpCoordBtn.MouseButton1Click:Connect(function()
    local text = coordBox.Text:gsub(" ", "")
    local parts = {}
    for part in string.gmatch(text, "[^,]+") do table.insert(parts, tonumber(part)) end
    if #parts >= 3 and parts[1] and parts[2] and parts[3] then
        TeleportToCFrame(CFrame.new(parts[1], parts[2], parts[3]))
        Print("TP a (" .. parts[1] .. ", " .. parts[2] .. ", " .. parts[3] .. ")")
    else
        Print("Formato inválido. Ej: 100,20,-50")
    end
end)

