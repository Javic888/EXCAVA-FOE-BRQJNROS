-- Refrescar lista
local function RefreshList()
	for _, v in pairs(scroll:GetChildren()) do
		if v:IsA("TextButton") then
			v:Destroy()
		end
	end

	for i, data in ipairs(Points) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -5, 0, 22)
		btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		btn.BorderSizePixel = 0
		btn.TextColor3 = Color3.fromRGB(0, 255, 0)
		btn.Font = Enum.Font.Code
		btn.TextSize = 14

		if SelectedIndex == i then
			btn.Text = ">> [" .. i .. "] " .. data.Name
		else
			btn.Text = "   [" .. i .. "] " .. data.Name
		end

		btn.Parent = scroll

		btn.MouseButton1Click:Connect(function()
			SelectedIndex = i
			Print("Seleccionaste: " .. data.Name .. " (Slot " .. i .. ")")
			RefreshList()
		end)
	end

	scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 5)
end

-- Guardar punto
local function SavePoint(name)
	if not name or name == "" then
		Print("ERROR: escribe un nombre.")
		return
	end

	local root = GetRoot()
	table.insert(Points, {Name = name, CFrame = root.CFrame})
	SelectedIndex = #Points

	Print("Guardado: " .. name .. " (Slot " .. SelectedIndex .. ")")
	RefreshList()
end

-- TP flotando
local function SmoothTeleport(targetCFrame)
	local root = GetRoot()
	local startPos = root.Position
	local endPos = targetCFrame.Position

	local distance = (endPos - startPos).Magnitude
	local duration = distance / smoothSpeed

	if duration < 0.05 then duration = 0.05 end
	if duration > 6 then duration = 6 end

	local startTime = tick()
	while tick() - startTime < duration do
		local alpha = (tick() - startTime) / duration
		local newPos = startPos:Lerp(endPos, alpha)
		root.CFrame = CFrame.new(newPos) * (targetCFrame - targetCFrame.Position)
		RunService.RenderStepped:Wait()
	end

	root.CFrame = targetCFrame
end

-- TP punto
local function TeleportToPoint()
	if not SelectedIndex or not Points[SelectedIndex] then
		Print("ERROR: selecciona un punto.")
		return
	end

	local target = Points[SelectedIndex].CFrame

	if smoothMode then
		Print("TP flotando -> " .. Points[SelectedIndex].Name)
		SmoothTeleport(target)
	else
		Print("TP instantáneo -> " .. Points[SelectedIndex].Name)
		GetRoot().CFrame = target
	end
end

-- Eliminar punto
local function DeletePoint()
	if not SelectedIndex or not Points[SelectedIndex] then
		Print("ERROR: no hay punto seleccionado.")
		return
	end

	Print("Eliminado: " .. Points[SelectedIndex].Name)
	table.remove(Points, SelectedIndex)
	SelectedIndex = nil
	RefreshList()
end

