        btn.Parent = contentContainer
        
        btn.MouseButton1Click:Connect(function()
            selectedPoint = name
            -- Resaltar seleccionado
            for _, child in pairs(contentContainer:GetChildren()) do
                if child:IsA("TextButton") then
                    child.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
                end
            end
            btn.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
        end)
        
        yOffset = yOffset + 40
    end
    
    contentContainer.CanvasSize = UDim2.new(0, 0, 0, yOffset + 10)
end

-- Función para guardar punto
local function savePoint(name, color)
    if name == "" then
        return false, "Escribe un nombre"
    end
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        return false, "Personaje no disponible"
    end
    points[name] = {
        cframe = char.HumanoidRootPart.CFrame,
        color = color or Color3.new(1, 0, 0)
    }
    savePoints()
    updateESP()
    refreshPointList()
    return true, "Punto guardado: " .. name
end

local function loadPoint(name)
    local point = points[name]
    if not point then
        return false, "Punto no encontrado"
    end
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = point.cframe
        return true, "Teletransportado a: " .. name
    end
    return false, "No se pudo teletransportar"
end

local function deletePoint(name)
    if points[name] then
        points[name] = nil
        local filePath = pointsFolder .. "/" .. name .. ".json"
        pcall(function() delfile(filePath) end)
        savePoints()
        updateESP()
        refreshPointList()
        if selectedPoint == name then selectedPoint = nil end
        return true, "Punto eliminado: " .. name
    end
    return false, "Punto no encontrado"
end

