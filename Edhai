-- SISTEMA DE PUNTOS TP
-- ============================================
local points = {}
local pointsFolder = "LipeHub_Points"
local selectedPoint = nil
local espEnabled = true
local espObjects = {}
local smoothMode = false
local smoothSpeed = 60

if not isfolder(pointsFolder) then
    makefolder(pointsFolder)
end

local function savePoints()
    for name, data in pairs(points) do
        local saveData = {
            x = data.cframe.X,
            y = data.cframe.Y,
            z = data.cframe.Z,
            r = data.color.r,
            g = data.color.g,
            b = data.color.b
        }
        pcall(function()
            writefile(pointsFolder .. "/" .. name .. ".json", game:GetService("HttpService"):JSONEncode(saveData))
        end)
    end
end

local function loadPoints()
    points = {}
    local files = listfiles(pointsFolder)
    for _, file in ipairs(files) do
        if file:match("%.json$") then
            local content = readfile(file)
            local data = game:GetService("HttpService"):JSONDecode(content)
            local name = file:match("([^/]+)%.json$")
            points[name] = {
                cframe = CFrame.new(data.x, data.y, data.z),
                color = Color3.new(data.r or 1, data.g or 0, data.b or 0)
            }
        end
    end
end

local function GetRoot()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

local function SmoothTeleport(targetCFrame)
    local root = GetRoot()
    root.Anchored = true
    local startPos = root.Position
    local endPos = targetCFrame.Position
    local distance = (endPos - startPos).Magnitude
    local duration = math.clamp(distance / smoothSpeed, 0.1, 8)
    local startTime = tick()
    while tick() - startTime < duration do
        local alpha = (tick() - startTime) / duration
        local newPos = startPos:Lerp(endPos, alpha)
        root.CFrame = CFrame.new(newPos) * (targetCFrame - targetCFrame.Position)
        RunService.RenderStepped:Wait()
    end
    root.CFrame = targetCFrame
    root.Anchored = false
end

local function TeleportToCFrame(targetCFrame)
    if smoothMode then
        SmoothTeleport(targetCFrame)
    else
        GetRoot().CFrame = targetCFrame
    end
end

-- ESP Visual
local function updateESP()
    for _, objs in pairs(espObjects) do
        pcall(function()
            if objs.billboard then objs.billboard:Destroy() end
            if objs.part then objs.part:Destroy() end
        end)
    end
    espObjects = {}
    if not espEnabled then return end
    for name, point in pairs(points) do
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_" .. name
        billboard.Size = UDim2.new(0, 150, 0, 35)
        billboard.StudsOffset = Vector3.new(0, 2, 0)
        billboard.AlwaysOnTop = true
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundColor3 = point.color
        frame.BackgroundTransparency = 0.4
        frame.BorderSizePixel = 1
        frame.BorderColor3 = Color3.new(1, 1, 1)
        frame.Parent = billboard
        local text = Instance.new("TextLabel")
        text.Size = UDim2.new(1, 0, 1, 0)
        text.BackgroundTransparency = 1
        text.Text = name
        text.TextColor3 = Color3.new(1, 1, 1)
        text.TextScaled = true
        text.Font = Enum.Font.GothamBold
        text.Parent = frame
        local part = Instance.new("Part")
        part.Name = "ESPPart_" .. name
        part.Size = Vector3.new(0.5, 0.5, 0.5)
        part.Anchored = true
        part.CanCollide = false
        part.Transparency = 1
        part.Position = point.cframe.Position
        part.Parent = workspace
        billboard.Adornee = part
        espObjects[name] = {billboard = billboard, part = part}
    end
end

local function refreshPointList()
    local container = scrollPoints
    if not container then return end
    for _, child in pairs(container:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local pointNames = {}
    for name, _ in pairs(points) do table.insert(pointNames, name) end
    table.sort(pointNames)
    for _, name in ipairs(pointNames) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -5, 0, 22)
        btn.BackgroundColor3 = (selectedPoint == name) and Color3.fromRGB(40, 40, 50) or Color3.fromRGB(20, 20, 20)
        btn.BorderSizePixel = 0
        btn.TextColor3 = Color3.fromRGB(0, 255, 0)
        btn.Font = Enum.Font.Code
        btn.TextSize = 12
        btn.Text = "📍 " .. name
        btn.Parent = container
        btn.MouseButton1Click:Connect(function()
            selectedPoint = name
            refreshPointList()
            Print("Seleccionado: " .. name)
        end)
    end
    if #pointNames == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, -5, 0, 22)
        empty.BackgroundTransparency = 1
        empty.Text = "   (No hay puntos)"
        empty.TextColor3 = Color3.fromRGB(100, 100, 100)
        empty.Font = Enum.Font.Code
        empty.TextSize = 12
        empty.TextXAlignment = Enum.TextXAlignment.Left
        empty.Parent = container
    end
end

local function savePoint(name, color)
    if name == "" then return false, "Escribe un nombre" end
    local root = GetRoot()
    points[name] = {cframe = root.CFrame, color = color or Color3.new(1, 0, 0)}
    savePoints()
    updateESP()
    refreshPointList()
    return true, "Punto guardado: " .. name
end

local function loadPoint(name)
    local point = points[name]
    if not point then return false, "Punto no encontrado" end
    TeleportToCFrame(point.cframe)
    return true, "TP a: " .. name
end

local function deletePoint(name)
    if points[name] then
        points[name] = nil
        local filePath = pointsFolder .. "/" .. name .. ".json"
        pcall(function() delfile(filePath) end)
        savePoints()
        updateESP()
        refreshPointList()
        if selectedPoint == name then selectedPoint = nil end
        return true, "Eliminado: " .. name
    end
    return false, "Punto no encontrado"
end

-- ============================================
-- SISTEMA DE INMORTALIDAD
-- ============================================
local immortalEnabled = false
local currentImmortality = "v1"
local immortalConnections = {}

local function clearImmortality()
    for _, conn in ipairs(immortalConnections) do
        pcall(function() if conn and conn.Disconnect then conn:Disconnect() end end)
    end
    immortalConnections = {}
end

local function startImmortalV1()
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    if not humanoid then return end
    local conn = humanoid:GetPropertyChangedSignal("Health"):Connect(function()
        if humanoid.Health <= 1 then humanoid.Health = humanoid.MaxHealth end
    end)
    table.insert(immortalConnections, conn)
end

local function startImmortalV2()
    local conn = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local hum = char.Humanoid
            if hum.Health <= 1 then hum.Health = hum.MaxHealth end
            if hum.PlatformStand == false then
                hum.PlatformStand = true
                task.wait(0.1)
                hum.PlatformStand = false
            end
        end
    end)
    table.insert(immortalConnections, conn)
end

local function startImmortalV3()
    local char = LocalPlayer.Character
    if not char then return end
    local healthConn = char:FindFirstChild("Humanoid"):GetPropertyChangedSignal("Health"):Connect(function()
        local hum = char:FindFirstChild("Humanoid")
        if hum and hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
    end)
    table.insert(immortalConnections, healthConn)
    local damageConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
        task.wait(0.5)
        local hum = newChar:FindFirstChild("Humanoid")
        if hum then
            hum.Health = hum.MaxHealth
            local breakConn = hum:GetPropertyChangedSignal("Health"):Connect(function()
                if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
            end)
            table.insert(immortalConnections, breakConn)
        end
    end)
    table.insert(immortalConnections, damageConn)
end

local function applyImmortality()
    clearImmortality()
    if not immortalEnabled then return end
    if currentImmortality == "v1" then startImmortalV1()
    elseif currentImmortality == "v2" then startImmortalV2()
    elseif currentImmortality == "v3" then startImmortalV3() end
end

-- ============================================
-- DESYNC
-- ============================================
local desyncActive = false

local function enableMobileDesync()
    pcall(function()
        local backpack = LocalPlayer:WaitForChild("Backpack")
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local humanoid = character:WaitForChild("Humanoid")
        local packages = ReplicatedStorage:WaitForChild("Packages", 5)
        if not packages then Print("❌ Packages no encontrado") return false end
        local netFolder = packages:WaitForChild("Net", 5)
        if not netFolder then Print("❌ Net folder no encontrado") return false end
        local useItemRemote = netFolder:WaitForChild("RE/UseItem", 5)
        local teleportRemote = netFolder:WaitForChild("RE/QuantumCloner/OnTeleport", 5)
        if not useItemRemote or not teleportRemote then Print("❌ Remotos no encontrados") return false end
        local tool
        for _, toolName in ipairs({"Quantum Cloner", "Brainrot", "brainrot"}) do
            tool = backpack:FindFirstChild(toolName) or character:FindFirstChild(toolName)
            if tool then break end
        end
        if not tool then
            for _, item in ipairs(backpack:GetChildren()) do
                if item:IsA("Tool") then tool = item break end
            end
        end
        if tool and tool.Parent == backpack then
            humanoid:EquipTool(tool)
            task.wait(0.5)
        end
        if setfflag then setfflag("WorldStepMax", "-9999999999") end
        task.wait(0.2)
        useItemRemote:FireServer()
        task.wait(1)
        teleportRemote:FireServer()
        task.wait(2)
        if setfflag then setfflag("WorldStepMax", "-1") end
        Print("✅ Desync activado!")
        return true
    end)
    return true
end

local function disableMobileDesync()
    pcall(function()
        if setfflag then setfflag("WorldStepMax", "-1") end
        Print("❌ Desync desactivado")
    end)
end

