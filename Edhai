TabGuiV1:Label("━━━━━━━━━━ INMORTALIDAD ━━━━━━━━━━")

local currentImmortality = "v1"
local immortalEnabled = false
local immortalConnections = {}

local function clearImmortality()
    for _, conn in ipairs(immortalConnections) do
        if conn and conn.Disconnect then pcall(function() conn:Disconnect() end) end
    end
    immortalConnections = {}
end

-- MÉTODO V1: Auto-revive rápido
local function startImmortalV1()
    local humanoid = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    local conn = humanoid:GetPropertyChangedSignal("Health"):Connect(function()
        if humanoid.Health <= 1 then
            humanoid.Health = humanoid.MaxHealth
        end
    end)
    table.insert(immortalConnections, conn)
end

-- MÉTODO V2: Loop constante + anti-caída
local function startImmortalV2()
    local conn = game:GetService("RunService").Stepped:Connect(function()
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local hum = char.Humanoid
            if hum.Health <= 1 then
                hum.Health = hum.MaxHealth
            end
            if hum.PlatformStand == false then
                hum.PlatformStand = true
                wait(0.1)
                hum.PlatformStand = false
            end
        end
    end)
    table.insert(immortalConnections, conn)
end

-- MÉTODO V3: Override total + reconexión
local function startImmortalV3()
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    
    local healthConn = char:FindFirstChild("Humanoid"):GetPropertyChangedSignal("Health"):Connect(function()
        local hum = char:FindFirstChild("Humanoid")
        if hum and hum.Health < hum.MaxHealth then
            hum.Health = hum.MaxHealth
        end
    end)
    table.insert(immortalConnections, healthConn)
    
    local damageConn = game:GetService("Players").LocalPlayer.CharacterAdded:Connect(function(newChar)
        wait(0.5)
        local hum = newChar:FindFirstChild("Humanoid")
        if hum then
            hum.Health = hum.MaxHealth
            local breakConn = hum:GetPropertyChangedSignal("Health"):Connect(function()
                if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
            end)
            table.insert(immortalConnections, breakConn)
        end
    end)
    table.insert(immortalConnections, damageConn)
end

local function applyImmortality()
    clearImmortality()
    if not immortalEnabled then return end
    
    if currentImmortality == "v1" then
        startImmortalV1()
    elseif currentImmortality == "v2" then
        startImmortalV2()
    elseif currentImmortality == "v3" then
        startImmortalV3()
    end
    DiscordLib:Notification("Inmortalidad", "Modo " .. string.upper(currentImmortality) .. " activado", "OK")
end

local function setImmortalityMethod(method)
    currentImmortality = method
    if immortalEnabled then
        applyImmortality()
    end
    DiscordLib:Notification("Inmortalidad", "Método cambiado a: " .. string.upper(method), "OK")
end

-- Toggle principal
TabGuiV1:Toggle("Inmortalidad (ON/OFF)", false, function(val)
    immortalEnabled = val
    if val then
        applyImmortality()
    else
        clearImmortality()
        DiscordLib:Notification("Inmortalidad", "Desactivada", "OK")
    end
end)

