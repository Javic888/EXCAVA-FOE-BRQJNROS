-- Crear carpeta si no existe
if not isfolder(pointsFolder) then
    makefolder(pointsFolder)
end

-- Guardar todos los puntos
local function saveAllPoints()
    for name, data in pairs(points) do
        local saveData = {
            x = data.cframe.X,
            y = data.cframe.Y,
            z = data.cframe.Z,
            rx = data.cframe:ToEulerAnglesXYZ(),
            color = data.color or Color3.new(1, 0, 0)
        }
        writefile(pointsFolder .. "/" .. name .. ".json", game:GetService("HttpService"):JSONEncode(saveData))
    end
    DiscordLib:Notification("Puntos", "Puntos guardados", "OK")
end

-- Cargar todos los puntos
local function loadAllPoints()
    points = {}
    local files = listfiles(pointsFolder)
    for _, file in ipairs(files) do
        if file:match("%.json$") then
            local content = readfile(file)
            local data = game:GetService("HttpService"):JSONDecode(content)
            local pointName = file:match("([^/]+)%.json$")
            local cframe = CFrame.new(data.x, data.y, data.z) * CFrame.fromEulerAnglesXYZ(data.rx[1], data.rx[2], data.rx[3])
            points[pointName] = {
                cframe = cframe,
                color = data.color and Color3.new(data.color.r, data.color.g, data.color.b) or Color3.new(1, 0, 0)
            }
        end
    end
    updatePointsList()
    if espEnabled then updateESP() end
    return #files
end

-- Guardar punto actual
local function saveCurrentPoint(name, color)
    if not name or name == "" then
        DiscordLib:Notification("Error", "Ingresa un nombre", "OK")
        return
    end
    local char = game.Players.LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        DiscordLib:Notification("Error", "Personaje no disponible", "OK")
        return
    end
    points[name] = {
        cframe = char.HumanoidRootPart.CFrame,
        color = color or Color3.new(1, 0, 0)
    }
    saveAllPoints()
    updatePointsList()
    if espEnabled then updateESP() end
    DiscordLib:Notification("Punto guardado", name, "OK")
end

-- Cargar punto (teletransportarse)
local function loadPoint(name)
    local point = points[name]
    if not point then
        DiscordLib:Notification("Error", "Punto no encontrado", "OK")
        return
    end
    local char = game.Players.LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = point.cframe
        DiscordLib:Notification("Teletransporte", "Cargando: " .. name, "OK")
    end
end

-- Eliminar punto
local function deletePoint(name)
    if points[name] then
        points[name] = nil
        local filePath = pointsFolder .. "/" .. name .. ".json"
        if isfile(filePath) then delfile(filePath) end
        updatePointsList()
        if espEnabled then updateESP() end
        DiscordLib:Notification("Punto eliminado", name, "OK")
    end
end

-- Editar nombre de punto
local function editPointName(oldName, newName)
    if not points[oldName] then
        DiscordLib:Notification("Error", "Punto no encontrado", "OK")
        return
    end
    if newName == "" or points[newName] then
        DiscordLib:Notification("Error", "Nombre inválido o ya existe", "OK")
        return
    end
    points[newName] = points[oldName]
    points[oldName] = nil
    local oldPath = pointsFolder .. "/" .. oldName .. ".json"
    if isfile(oldPath) then delfile(oldPath) end
    saveAllPoints()
    updatePointsList()
    if espEnabled then updateESP() end
    DiscordLib:Notification("Punto renombrado", oldName .. " → " .. newName, "OK")
end

-- ============================================
-- ESP VISUAL (PUNTOS EN 3D)
-- ============================================
local function createESPForPoint(name, point)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "PointESP_" .. name
    billboard.Size = UDim2.new(0, 200, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = workspace
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = point.color
    frame.BackgroundTransparency = 0.5
    frame.BorderSizePixel = 1
    frame.BorderColor3 = Color3.new(1, 1, 1)
    frame.Parent = billboard
    
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = name .. "\n" .. string.format("X: %.0f Y: %.0f Z: %.0f", point.cframe.X, point.cframe.Y, point.cframe.Z)
    text.TextColor3 = Color3.new(1, 1, 1)
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    text.Parent = frame
    
    -- Posicionar en el mundo
    local part = Instance.new("Part")
    part.Name = "ESP_Part_" .. name
    part.Size = Vector3.new(0.5, 0.5, 0.5)
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 1
    part.Position = point.cframe.Position
    part.Parent = workspace
    billboard.Adornee = part
    
    espObjects[name] = {billboard = billboard, part = part}
end

local function clearESP()
    for name, objs in pairs(espObjects) do
        if objs.billboard then objs.billboard:Destroy() end
        if objs.part then objs.part:Destroy() end
    end
    espObjects = {}
end

local function updateESP()
    clearESP()
    if not espEnabled then return end
    for name, point in pairs(points) do
        createESPForPoint(name, point)
    end
end

-- Toggle ESP
local function toggleESP(state)
    espEnabled = state
    if state then
        updateESP()
    else
        clearESP()
    end
end

