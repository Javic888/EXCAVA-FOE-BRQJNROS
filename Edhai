-- ============================================
-- SISTEMA DE PUNTOS (GUARDADO LOCAL)
-- ============================================
local points = {}
local pointsFolder = "Menu_Points"
local currentSelectedPoint = nil

if not isfolder(pointsFolder) then
    makefolder(pointsFolder)
end

local function saveAllPoints()
    for name, cframe in pairs(points) do
        local data = {
            x = cframe.X,
            y = cframe.Y,
            z = cframe.Z,
            rx = cframe:ToEulerAnglesXYZ()
        }
        writefile(pointsFolder .. "/" .. name .. ".json", game:GetService("HttpService"):JSONEncode(data))
    end
    DiscordLib:Notification("Puntos", "Puntos guardados", "OK")
end

local function loadAllPoints()
    points = {}
    local files = listfiles(pointsFolder)
    for _, file in ipairs(files) do
        if file:match("%.json$") then
            local content = readfile(file)
            local data = game:GetService("HttpService"):JSONDecode(content)
            local pointName = file:match("([^/]+)%.json$")
            local cframe = CFrame.new(data.x, data.y, data.z) * CFrame.fromEulerAnglesXYZ(data.rx[1], data.rx[2], data.rx[3])
            points[pointName] = cframe
        end
    end
    return #files
end

local function saveCurrentPoint(name)
    if not name or name == "" then
        DiscordLib:Notification("Error", "Ingresa un nombre", "OK")
        return
    end
    local char = game.Players.LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        DiscordLib:Notification("Error", "Personaje no disponible", "OK")
        return
    end
    points[name] = char.HumanoidRootPart.CFrame
    saveAllPoints()
    updatePointsList()
    DiscordLib:Notification("Punto guardado", name, "OK")
end

local function loadPoint(name)
    local point = points[name]
    if not point then
        DiscordLib:Notification("Error", "Punto no encontrado", "OK")
        return
    end
    local char = game.Players.LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = point
        DiscordLib:Notification("Teletransporte", "Cargando: " .. name, "OK")
    end
end

local function deletePoint(name)
    if points[name] then
        points[name] = nil
        local filePath = pointsFolder .. "/" .. name .. ".json"
        if isfile(filePath) then delfile(filePath) end
        updatePointsList()
        DiscordLib:Notification("Punto eliminado", name, "OK")
    end
end

local pointsDropdown = nil
local function updatePointsList()
    if pointsDropdown then
        local pointNames = {}
        for name, _ in pairs(points) do table.insert(pointNames, name) end
        table.sort(pointNames)
        pointsDropdown:Clear()
        for _, name in ipairs(pointNames) do pointsDropdown:Add(name) end
        if #pointNames == 0 then pointsDropdown:Add("(No hay puntos)") end
    end
end

-- ============================================
-- SISTEMA DE INMORTALIDAD (3 MÉTODOS DIFERENTES)
-- ============================================
local currentImmortality = "v1"  -- v1, v2, v3
local immortalEnabled = false
local immortalConnections = {}  -- guardar conexiones para limpiar después

-- Función para limpiar métodos anteriores
local function clearImmortality()
    for _, conn in ipairs(immortalConnections) do
        if conn and conn.Disconnect then pcall(function() conn:Disconnect() end) end
    end
    immortalConnections = {}
end

-- MÉTODO V1: Health cambiado por debajo de 1 (Auto-revive rápido)
local function startImmortalV1()
    local humanoid = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    local conn = humanoid:GetPropertyChangedSignal("Health"):Connect(function()
        if humanoid.Health <= 1 then
            humanoid.Health = humanoid.MaxHealth
        end
    end)
    table.insert(immortalConnections, conn)
end

-- MÉTODO V2: Loop con spawn (más resistente a anti-cheat)
local function startImmortalV2()
    local conn = game:GetService("RunService").Stepped:Connect(function()
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local hum = char.Humanoid
            if hum.Health <= 1 then
                hum.Health = hum.MaxHealth
            end
            -- También evitar daño por caída
            if hum.PlatformStand == false then
                hum.PlatformStand = true
                wait(0.1)
                hum.PlatformStand = false
            end
        end
    end)
    table.insert(immortalConnections, conn)
end

-- MÉTODO V3: Simulación de daño cero y auto-curación inmediata
local function startImmortalV3()
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    
    -- Resetear salud si baja
    local healthConn = char:FindFirstChild("Humanoid"):GetPropertyChangedSignal("Health"):Connect(function()
        local hum = char:FindFirstChild("Humanoid")
        if hum and hum.Health < hum.MaxHealth then
            hum.Health = hum.MaxHealth
        end
    end)
    table.insert(immortalConnections, healthConn)
    
    -- Bloquear daño directo (override)
    local damageConn = game:GetService("Players").LocalPlayer.CharacterAdded:Connect(function(newChar)
        wait(0.5)
        local hum = newChar:FindFirstChild("Humanoid")
        if hum then
            hum.Health = hum.MaxHealth
            local breakConn = hum:GetPropertyChangedSignal("Health"):Connect(function()
                if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
            end)
            table.insert(immortalConnections, breakConn)
        end
    end)
    table.insert(immortalConnections, damageConn)
end

-- Activar según el método actual
local function applyImmortality()
    clearImmortality()
    if not immortalEnabled then return end
    
    if currentImmortality == "v1" then
        startImmortalV1()
    elseif currentImmortality == "v2" then
        startImmortalV2()
    elseif currentImmortality == "v3" then
        startImmortalV3()
    end
    DiscordLib:Notification("Inmortalidad", "Modo " .. string.upper(currentImmortality) .. " activado", "OK")
end

-- Función para cambiar el método
local function setImmortalityMethod(method)
    currentImmortality = method
    if immortalEnabled then
        applyImmortality()
    end
    DiscordLib:Notification("Inmortalidad", "Método cambiado a: " .. string.upper(method), "OK")
end

-- Toggle principal de inmortalidad
local immortalToggle = nil
immortalToggle = TabGuiV1:Toggle("Inmortalidad (ON/OFF)", false, function(val)
    immortalEnabled = val
    if val then
        applyImmortality()
    else
        clearImmortality()
        DiscordLib:Notification("Inmortalidad", "Desactivada", "OK")
    end
end)

-- Dropdown para elegir método
local methodDropdown = TabGuiV1:Dropdown("Método de Inmortalidad", {"v1 - Auto-revive rápido", "v2 - Loop + Anti-caída", "v3 - Override total"}, function(value)
    if value == "v1 - Auto-revive rápido" then
        setImmortalityMethod("v1")
    elseif value == "v2 - Loop + Anti-caída" then
        setImmortalityMethod("v2")
    elseif value == "v3 - Override total" then
        setImmortalityMethod("v3")
    end
end)
methodDropdown:Select("v1 - Auto-revive rápido")

