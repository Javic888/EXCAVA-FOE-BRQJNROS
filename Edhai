-- SPEED BOOSTER MEJORADO
-- ============================================
local speedActive = false
local speedConn = nil
local baseSpeed = 27
local speedMultiplier = 1

local function getMovementInput()
    local char = LocalPlayer.Character
    if not char then return Vector3.new(0, 0, 0) end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return Vector3.new(0, 0, 0) end
    local moveVector = hum.MoveDirection
    if moveVector.Magnitude > 0.1 then
        return moveVector.Unit
    end
    return Vector3.new(0, 0, 0)
end

local function startSpeedControl()
    if speedConn then return end
    
    speedConn = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local inputDirection = getMovementInput()
        local finalSpeed = baseSpeed * speedMultiplier
        
        if inputDirection.Magnitude > 0 then
            hrp.AssemblyLinearVelocity = Vector3.new(
                inputDirection.X * finalSpeed,
                hrp.AssemblyLinearVelocity.Y,
                inputDirection.Z * finalSpeed
            )
        else
            hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
        end
    end)
    Print("⚡ Speed Booster ACTIVADO - Velocidad: " .. finalSpeed)
end

local function stopSpeedControl()
    if speedConn then 
        speedConn:Disconnect() 
        speedConn = nil 
    end
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, char.HumanoidRootPart.AssemblyLinearVelocity.Y, 0)
    end
    Print("⚡ Speed Booster DESACTIVADO")
end

local function toggleSpeed()
    speedActive = not speedActive
    if speedActive then
        startSpeedControl()
    else
        stopSpeedControl()
    end
end

