--// Terminal print
local function Print(msg)
	output.Text = output.Text .. "\n" .. msg
end

--// Lista refrescar
local function RefreshList()
	for _, v in pairs(scroll:GetChildren()) do
		if v:IsA("TextButton") then
			v:Destroy()
		end
	end

	for i, data in ipairs(Points) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -5, 0, 22)
		btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		btn.BorderSizePixel = 0
		btn.TextColor3 = Color3.fromRGB(0, 255, 0)
		btn.Font = Enum.Font.Code
		btn.TextSize = 14

		if SelectedIndex == i then
			btn.Text = ">> [" .. i .. "] " .. data.Name
		else
			btn.Text = "   [" .. i .. "] " .. data.Name
		end

		btn.Parent = scroll

		btn.MouseButton1Click:Connect(function()
			SelectedIndex = i
			Print("Seleccionaste: " .. data.Name .. " (Slot " .. i .. ")")
			RefreshList()
		end)
	end

	scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 5)
end

--// Guardar punto
local function SavePoint(name)
	if not name or name == "" then
		Print("ERROR: escribe un nombre.")
		return
	end

	local root = GetRoot()
	table.insert(Points, {Name = name, CFrame = root.CFrame})
	SelectedIndex = #Points

	Print("Guardado: " .. name .. " (Slot " .. SelectedIndex .. ")")
	RefreshList()
end

--// TP punto
local function TeleportToPoint()
	if not SelectedIndex or not Points[SelectedIndex] then
		Print("ERROR: selecciona un punto.")
		return
	end

	local root = GetRoot()
	root.CFrame = Points[SelectedIndex].CFrame
	Print("TP -> " .. Points[SelectedIndex].Name)
end

--// Eliminar punto
local function DeletePoint()
	if not SelectedIndex or not Points[SelectedIndex] then
		Print("ERROR: no hay punto seleccionado.")
		return
	end

	Print("Eliminado: " .. Points[SelectedIndex].Name)
	table.remove(Points, SelectedIndex)
	SelectedIndex = nil
	RefreshList()
end

