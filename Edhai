-- Detectar muerte y guardar posicion
local function SetupCharacter(char)
	local humanoid = char:WaitForChild("Humanoid")
	local root = char:WaitForChild("HumanoidRootPart")

	humanoid.Died:Connect(function()
		if autoRespawnTP then
			lastDeathCFrame = root.CFrame
			Print("Muerte detectada, guardando posición...")
		end
	end)
end

-- Respawn TP
player.CharacterAdded:Connect(function(char)
	SetupCharacter(char)

	task.wait(0.2)

	if autoRespawnTP and lastDeathCFrame then
		local root = char:WaitForChild("HumanoidRootPart")
		root.CFrame = lastDeathCFrame
		Print("TP automático al lugar de muerte completado.")
	end
end)

-- Primera vez
if player.Character then
	SetupCharacter(player.Character)
end

-- DRAG
local dragging = false
local dragStart
local startPos

topbar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
	end
end)

topbar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

